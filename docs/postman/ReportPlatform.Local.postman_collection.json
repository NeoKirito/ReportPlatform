    {
      "name": "Print - manual local diagnostic job",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jobName\": \"Postman-local-print\",\n  \"report\": {\n    \"reportId\": \"{{bbid}}\",\n    \"parameters\": {},\n    \"profile\": \"legacy\",\n    \"watermark\": { \"enabled\": true },\n    \"fileName\": \"{{fileName}}\",\n    \"legacyPayload\": {\n      \"pageNo\": 1,\n      \"pageSize\": 100,\n      \"djh\": {\n        \"grtjgcjjgid\": \"{{grtjgcjjgid}}\",\n        \"sfxmddid\": \"{{sfxmddid}}\"\n      },\n      \"yhmc\": \"{{yhmc}}\",\n      \"bbid\": \"{{bbid}}\",\n      \"fileName\": \"{{fileName}}\",\n      \"querytype\": \"djwh\"\n    }\n  },\n  \"targets\": [\n    {\n      \"agentId\": \"{{agentId}}\",\n      \"printerName\": \"{{printerName}}\",\n      \"copies\": 1,\n      \"duplex\": false\n    }\n  ]\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/print/jobs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "print", "jobs"]
        },
        "description": "Installation and troubleshooting route. On this computer the agent currently uses DryRun, so the job returns Completed without paper output."
      },
      "response": []
    },
