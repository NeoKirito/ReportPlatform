    {
      "name": "Legacy compatibility - GetReportByJson (PDF)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json; charset=utf-8", "type": "text" },
          { "key": "Accept", "value": "application/pdf", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pageNo\": 1,\n  \"pageSize\": 100,\n  \"djh\": {\n    \"grtjgcjjgid\": \"{{grtjgcjjgid}}\",\n    \"sfxmddid\": \"{{sfxmddid}}\"\n  },\n  \"yhmc\": \"{{yhmc}}\",\n  \"bbid\": \"{{bbid}}\",\n  \"fileName\": \"{{fileName}}\",\n  \"querytype\": \"djwh\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/Reports/GetReportByJson",
          "host": ["{{baseUrl}}"],
          "path": ["api", "Reports", "GetReportByJson"]
        },
        "description": "Successful calls return application/pdf. Use Save Response > Save to a file and do not publish the PDF."
      },
      "response": []
    },
    {
      "name": "FRX DOCX export - GetReportDocxByJson (Word)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json; charset=utf-8", "type": "text" },
          { "key": "Accept", "value": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pageNo\": 1,\n  \"pageSize\": 100,\n  \"djh\": {\n    \"grtjgcjjgid\": \"{{grtjgcjjgid}}\",\n    \"sfxmddid\": \"{{sfxmddid}}\"\n  },\n  \"yhmc\": \"{{yhmc}}\",\n  \"bbid\": \"{{bbid}}\",\n  \"fileName\": \"{{fileName}}\",\n  \"querytype\": \"djwh\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/Reports/GetReportDocxByJson",
          "host": ["{{baseUrl}}"],
          "path": ["api", "Reports", "GetReportDocxByJson"]
        },
        "description": "Uses the same request payload as PDF. Save Response as .docx, then open with the local default Word/WPS application."
      },
      "response": []
    },
