{
  "Agent": {
    "ServerUrl": "https://<REPORT_API_HOST>:<REPORT_API_PORT>",
    "AgentId": "",
    "RegistrationToken": "<REGISTRATION_TOKEN>",
    "StationId": "<STATION_ID>",
    "PrinterBindings": {
      "A4_GUIDE": "<A4_GUIDE_PRINTER_NAME>",
      "BARCODE": "<BARCODE_PRINTER_NAME>"
    },
    "HeartbeatSeconds": 20,
    "WorkDirectory": ".runtime/print-agent",
    "PrintBackend": {
      "Mode": "DryRun",
      "Executable": "",
      "ArgumentsTemplate": "{file} {printer} {copies} {duplex}",
      "RetryCount": 1,
      "RetryDelaySeconds": 2
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.SignalR.Client": "Warning"
    }
  }
}
