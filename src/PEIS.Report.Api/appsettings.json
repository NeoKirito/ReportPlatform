{
  "Urls": "http://0.0.0.0:82",
  "ReportEngine": {
    "DefinitionSource": "Deterministic",
    "Renderer": "FastReport",
    "DefinitionCacheDirectory": ".runtime/definition-cache",
    "WarmupReportIds": ["jktjbbd", "zytjbbd", "dwtjbgd"]
  },
  "ReportDatabase": {
    "Provider": "SqlServer",
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "DefinitionCacheTtlSeconds": 3600
  },
  "LegacyReportSchema": {
    "DefinitionTable": "dbo.xt_bgdy_djwh_zzj",
    "ReportIdColumn": "djid",
    "TemplateColumn": "dj_frx",
    "SqlColumn": "djsql",
    "VersionColumn": "",
    "UpdatedAtColumn": "",
    "TemplateContentEncoding": "Base64Utf8",
    "FirstResultSetTableName": "Master",
    "SupplementalQueryOrderColumn": "xh",
    "TemplateKeyPrefix": "legacy-djwh"
  },
  "Rendering": {
    "MaxConcurrentRenders": 4
  },
  "ImageResolution": {
    "MaxConcurrentFetches": 4,
    "TimeoutSeconds": 3,
    "MaxCachedItems": 256,
    "FailureCacheSeconds": 300
  },
  "PrintAgentSecurity": {
    "RegistrationToken": ""
  },
  "ReportDeliverySecurity": {
    "UploadToken": "",
    "ArtifactLifetimeMinutes": 120,
    "MaxUploadBytes": 104857600
  },
  "PrintAgentRegistry": {
    "OfflineAfterSeconds": 90
  },
  "PrintRouting": {
    "Scenarios": {
      "REGISTRATION_PRINT": {
        "JobName": "登记一键打印",
        "Documents": [
          {
            "Key": "guide-sheet",
            "ReportId": "GUIDE_A4",
            "PrinterRole": "A4_GUIDE",
            "Profile": "print-a4",
            "Copies": 1,
            "Duplex": false,
            "WatermarkEnabled": false,
            "FileName": "导检单.pdf"
          },
          {
            "Key": "barcode",
            "ReportId": "REG_BARCODE",
            "PrinterRole": "BARCODE",
            "Profile": "label",
            "Copies": 1,
            "Duplex": false,
            "WatermarkEnabled": false,
            "FileName": "条形码.pdf"
          }
        ]
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
