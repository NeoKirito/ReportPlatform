{
  "Agent": {
    "ServerUrl": "http://127.0.0.1:5080",
    "AgentId": "",
    "RegistrationToken": "",
    "StationId": "AUTO",
    "PrinterBindings": {
      "A4_GUIDE": "Microsoft Print to PDF",
      "BARCODE": "Microsoft Print to PDF"
    },
        "HeartbeatSeconds": 20,
    "MaxConcurrentDownloads": 2,
    "WorkDirectory": ".runtime/print-agent",

    "Preview": {
      "Enabled": true,
      "WindowWidth": 1100,
      "WindowHeight": 820
    },

    "Printing": {
      "Silent": false,
      "DefaultPrinter": ""
    },

    "PrintBackend": {
      "Mode": "DryRun",
      "Executable": "",
      "ArgumentsTemplate": "{file} {printer} {copies} {duplex}",
      "RetryCount": 1,
      "RetryDelaySeconds": 2
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.SignalR.Client": "Warning"
    }
  }
}
